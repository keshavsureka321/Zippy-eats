# ==============================================================
# SLIDE 3 — GRAPH 1: 2x2 Interaction Bar Chart
# ==============================================================
plt.figure(figsize=(8, 5))
interaction = profiles.groupby(['high_prep', 'high_disc'])['cancellation_rate_pct'].mean().unstack()
interaction.index   = ['Normal Prep (<=25 min)', 'High Prep (>25 min)']
interaction.columns = ['Low Discount (<=20%)', 'High Discount (>20%)']

x     = np.arange(2)
width = 0.35
bars1 = plt.bar(x - width/2, interaction['Low Discount (<=20%)'],
                width, color='#0D9488', edgecolor='white', label='Low Discount (<=20%)')
bars2 = plt.bar(x + width/2, interaction['High Discount (>20%)'],
                width, color='#DC2626', edgecolor='white', label='High Discount (>20%)')

for bar, val in zip(bars1, interaction['Low Discount (<=20%)']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.2,
             f"{val:.1f}%", ha='center', fontsize=11, fontweight='bold')
for bar, val in zip(bars2, interaction['High Discount (>20%)']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.2,
             f"{val:.1f}%", ha='center', fontsize=11, fontweight='bold')

plt.xticks(x, interaction.index)
plt.title("2x2: Prep Time x Discount → Cancellation Rate\n(High Prep + High Discount = 6x worse)", fontweight='bold')
plt.ylabel("Avg Cancellation Rate (%)")
plt.ylim(0, 18)
plt.legend()
plt.tight_layout()
plt.savefig(r"C:\Users\Keshav\OneDrive\Desktop\slide3_2x2.png", dpi=200, bbox_inches='tight')
plt.show()
print("Slide 3 Graph 1 saved.")


# ==============================================================
# SLIDE 3 — GRAPH 2: Scatter (Discount vs Prep Time)
# ==============================================================
plt.figure(figsize=(8, 5))
low_c  = profiles[profiles['cancellation_rate_pct'] <= 4]
mid_c  = profiles[(profiles['cancellation_rate_pct'] > 4) & (profiles['cancellation_rate_pct'] <= 8)]
high_c = profiles[profiles['cancellation_rate_pct'] > 8]

