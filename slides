            color='#16A34A', alpha=0.75, s=65, label='Low Cancel (<=4%)')
plt.scatter(mid_c['discount_offered_pct'],  mid_c['avg_prep_time_min'],
            color='#F59E0B', alpha=0.75, s=65, label='Medium Cancel (4-8%)')
plt.scatter(high_c['discount_offered_pct'], high_c['avg_prep_time_min'],
            color='#DC2626', alpha=0.85, s=80, label='High Cancel (>8%)')

