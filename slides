
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Load data
profiles = pd.read_csv(r"C:\Users\Keshav\Downloads\zippyeats restaurant profiles.csv")
trends   = pd.read_csv(r"C:\Users\Keshav\Downloads\zippyeats monthly trends.csv")

profiles['high_prep'] = profiles['avg_prep_time_min'] > 25
profiles['high_disc']  = profiles['discount_offered_pct'] > 20
profiles['cohort']     = pd.cut(profiles['onboarding_month'],
                                 bins=[0, 3, 6, 18],
                                 labels=['Early (Mo 1-3)', 'Mid (Mo 4-6)', 'Late (Mo 7-18)'])

# ==============================================================
# SLIDE 2 — GRAPH 1: Cancellation Rate by Cuisine
# ==============================================================
plt.figure(figsize=(8, 5))
cancel_by_cuisine = profiles.groupby('cuisine_type')['cancellation_rate_pct'].mean().sort_values()
platform_avg      = profiles['cancellation_rate_pct'].mean()
colors            = ['#16A34A' if v < platform_avg else '#DC2626' for v in cancel_by_cuisine]

bars = plt.barh(cancel_by_cuisine.index, cancel_by_cuisine.values,
                color=colors, edgecolor='white')
for bar, val in zip(bars, cancel_by_cuisine.values):
    plt.text(val + 0.1, bar.get_y() + bar.get_height()/2,
             f"{val:.1f}%", va='center', fontsize=10, fontweight='bold')

plt.axvline(x=platform_avg, color='grey', linestyle='--',
            label=f"Platform avg: {platform_avg:.1f}%")
plt.title("Cancellation Rate by Cuisine\n(Red = above platform average)", fontweight='bold')
plt.xlabel("Avg Cancellation Rate (%)")
plt.legend()
plt.tight_layout()
plt.savefig(r"C:\Users\Keshav\OneDrive\Desktop\slide2_cuisine.png", dpi=200, bbox_inches='tight')
plt.show()
print("Slide 2 Graph 1 saved.")


# ==============================================================
# SLIDE 2 — GRAPH 2: Churn Rate by Zone
# ==============================================================
plt.figure(figsize=(7, 5))
zone_churn = profiles.groupby('city_zone').agg(
    churn_rate=('is_active', lambda x: (x == 0).mean() * 100)
).reset_index().sort_values('churn_rate', ascending=False)
zone_churn['zone_short'] = zone_churn['city_zone'].str.split(' - ').str[-1]

colors = ['#DC2626' if v > 15 else '#F59E0B' if v > 10 else '#16A34A'
          for v in zone_churn['churn_rate']]
bars = plt.bar(zone_churn['zone_short'], zone_churn['churn_rate'],
               color=colors, edgecolor='white', width=0.5)
for bar, val in zip(bars, zone_churn['churn_rate']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.3,
             f"{val:.1f}%", ha='center', fontsize=11, fontweight='bold')

plt.axhline(y=5, color='grey', linestyle='--', label='Target: 5%')
plt.title("Partner Churn Rate by Zone", fontweight='bold')
plt.ylabel("Churn Rate (%)")
plt.ylim(0, max(zone_churn['churn_rate']) + 8)
plt.legend()
plt.tight_layout()
plt.savefig(r"C:\Users\Keshav\OneDrive\Desktop\slide2_zone.png", dpi=200, bbox_inches='tight')
plt.show()
print("Slide 2 Graph 2 saved.")


